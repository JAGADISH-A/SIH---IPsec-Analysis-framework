# IPsec Sentinel — frontend environment
#
# Copy to `.env.local` and adjust. Only VITE_-prefixed variables are exposed to
# the browser, so NEVER put a secret, API key or token in this file: everything
# here is shipped to the client.

# Serve simulated data from the frontend. Set to false once the backend exists.
VITE_USE_MOCK_DATA=true

# Base URL of the REST API. Unused while VITE_USE_MOCK_DATA is true.
VITE_API_BASE_URL=/api/v1

# Default refresh cadence for dashboard and session queries (milliseconds).
VITE_REFRESH_INTERVAL_MS=30000

# Event cadence for the live monitor (milliseconds).
VITE_LIVE_EVENT_INTERVAL_MS=2600

# Product name shown in the interface.
VITE_APP_NAME=IPsec Sentinel
