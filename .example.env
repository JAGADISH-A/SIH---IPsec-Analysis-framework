# SIHColayer — Phase 10 example environment (no secrets)
#
# Copy to .env (never committed) and adjust. Every variable is safe by
# default: streaming stays in-memory, production execution stays OFF.
# The dashboard/API is read-only; enforcement never accepts network input.

# --- production execution (fail-closed: OFF by default) ------------
SIHEXEC_MODE=DRY_RUN
SIHEXEC_ENABLE_PRODUCTION_EXECUTION=false
SIHEXEC_ALLOWED_TESTBED_TARGETS=
SIHEXEC_EXECUTOR_WHITELIST=xdp,firewall,strongswan

# --- streaming (transport defaults to in-memory) --------------------
SIH_STREAM_TRANSPORT=memory
SIH_STREAM_KAFKA_ENABLED=false
SIH_STREAM_BOOTSTRAP_SERVERS=127.0.0.1:9092
SIH_STREAM_CONSUMER_GROUP=sih-colayer
SIH_STREAM_WINDOW_MS=100
SIH_STREAM_WINDOW_LOOKBACK=2
SIH_STREAM_OVERFLOW_POLICY=BLOCK
SIH_STREAM_DEDUP_SIZE=10000
SIH_STREAM_DLQ_MAX=10000

# --- API -------------------------------------------------------------
SIHAPI_HOST=127.0.0.1
SIHAPI_PORT=8000
SIH_TRAFFIC_GENERATOR_MONITORED=false

# --- evidence ----------------------------------------------------------
# Root directory that holds registered PCAP captures (evidence-id based).
SIHEVIDENCE_ROOT=evidence

# --- AI explanation service (Server C, backend only) ----------------------
# The natural-language reasoning layer. Backend-only: the key is never sent to
# the browser and never appears in an API response or a log line. The browser
# talks only to the AI service on ANALYTICS_AI_PORT.
#
# Put these in a local, gitignored `.env` next to this file, not in this
# template: this file is committed and must never carry a key. `python -m
# correlation.ai.service` reads `.env` at startup, and a real environment
# variable always overrides a value found in the file.
#
# GEMINI_API_KEY   Google Gemini API key. Unset -> no model, and the assistant
#                  answers from recorded values via the deterministic template.
# GEMINI_MODEL     Model id (default gemini-3.8-flash).
# GEMINI_TIMEOUT_S Request timeout in seconds (default 30).
# GEMINI_MAX_TOKENS Max output tokens, shared by the thinking budget
#                  and the answer (default 2048).
#
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_S=30
GEMINI_MAX_TOKENS=2048
# Read the investigation context from a running analytics API instead of an
# in-process store (required to explain LIVE testbed assessments).
# ANALYTICS_API_URL=http://127.0.0.1:8081

# Read the investigation context from a running analytics API instead of an
# in-process store (required to explain LIVE testbed assessments).
# ANALYTICS_API_URL=http://127.0.0.1:8081
# ANALYTICS_AI_HOST=127.0.0.1
# ANALYTICS_AI_PORT=8082
